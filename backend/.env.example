# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/zipdb

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256

# USPS API Configuration
USPS_API_KEY=your-usps-api-key  # Get this from https://www.usps.com/business/web-tools-apis/
USPS_API_URL=http://production.shippingapis.com/ShippingAPI.dll

# Optional: Census API for population data (future implementation)
CENSUS_API_KEY=your-census-api-key

# Optional: Geocoding API for coordinates (future implementation)
GEOCODING_API_KEY=your-geocoding-api-key

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
USPS_RATE_LIMIT_PER_SECOND=5  # Maximum API calls per second
USPS_BATCH_SIZE=5             # Number of ZIP codes to process in parallel 

